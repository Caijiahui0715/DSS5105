# Backend settings: server.py, demo.py and the data scripts all read this file.
# Copy it, name the copy .env (in the same folder) and fill in the values. .env is never committed to Git.
# One KEY=value per line; put comments on lines of their own, never after a value.

# ---- Required ----
# An OpenAI API key, and the name of a model that supports tool calling (the server uses the Responses API).
OPENAI_API_KEY=
OPENAI_MODEL=

# The project's PostgreSQL: listings, accounts and conversations are all stored there (see "Data and storage" in README.md).
# All five are needed. Once they are filled in, run python setup_database.py to create the tables and import the data.
# Tests use <DB_NAME>_test on the same server.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PASSWORD=

# ---- Optional ----
# How many seconds to wait for the database at most (10 by default).
# DB_CONNECT_TIMEOUT=10

# ---- Optional: OneMap, needed to recompute commute times (build_commutes.py, show_route.py), to search by place name,
# ---- and to work out commute times to places the user names (a gym, an office and so on) ----
# ONEMAP_EMAIL=
# ONEMAP_PASSWORD=
# An existing OneMap token; without it, the email and password above are used to get one.
# ONEMAP_TOKEN=
# The most route queries per minute the backend sends to OneMap (240 by default). Run check_onemap_rate.py once and use its suggestion.
# ONEMAP_CALLS_PER_MINUTE=240

# ---- Optional: an invite code needed to register; without it, anyone can register (for the online site, see deploy/README.md) ----
# REGISTRATION_CODE=

# ---- Optional: needed only to rerun fix_transit_google.py ----
# GOOGLE_MAPS_API_KEY=
