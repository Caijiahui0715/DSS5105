# Front-end (Streamlit) settings.
# Copy it, name the copy app/.env and fill in the values. app/.env is never committed to Git.
# One KEY=value per line, with comments on lines of their own. Restart Streamlit after a change.

# The address of the backend, server.py; this is the default, so no change is needed when the backend runs on this computer on the default port.
BACKEND_URL=http://127.0.0.1:8000

# Optional: the sign-in page shows "Continue with demo account", which signs in with this account in one click.
# Register the account in the app first. Everyone who uses this button shares its conversations and favorites.
# DEMO_USERNAME=demo_user
# DEMO_PASSWORD=

# Optional: the offline demo mode (static data and a demo agent, no backend and no real accounts).
# AGENT_MODE=mock
