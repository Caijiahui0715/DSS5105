# 后端设置：server.py、demo.py 和数据脚本都读这个文件。
# 复制一份，改名为 .env（放在同一个文件夹），再填上值。.env 不会被提交到 Git。
# 每行一个 KEY=value；注释单独占一行，不要写在值的后面。

# ---- 必填 ----
# OpenAI 的 API key，以及一个支持 tool calling 的模型名（服务端用 Responses API 调用）。
OPENAI_API_KEY=
OPENAI_MODEL=

# 项目的 PostgreSQL：房源、账号和对话都存在这里（详见 README 的“数据和存储位置”）。
# 第一次填好后运行 python setup_database.py 建表并导入数据。测试用同一台服务器上的 <DB_NAME>_test。
DB_HOST=localhost
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PASSWORD=

# ---- 可选 ----
# 连接数据库最多等几秒（默认 10）。
# DB_CONNECT_TIMEOUT=10

# ---- 可选：OneMap，重算通勤时间（build_commutes.py、show_route.py）、按地名找房、
# ---- 以及算到用户说的地点（健身房、公司等）的通勤时间时需要 ----
# ONEMAP_EMAIL=
# ONEMAP_PASSWORD=
# 已有的 OneMap 令牌；不填时用上面的邮箱和密码自动获取。
# ONEMAP_TOKEN=
# 后端每分钟最多向 OneMap 查几次路线（默认 240）。运行一次 check_onemap_rate.py，按它的建议填。
# ONEMAP_CALLS_PER_MINUTE=240

# ---- 可选：只有重跑 fix_transit_google.py 时需要 ----
# GOOGLE_MAPS_API_KEY=
