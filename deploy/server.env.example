# Settings for the online server. Copy this file to deploy/server.env and fill it in (server.env never goes into Git).
# deploy.py uploads it unchanged to ~/dss5105-config/server.env on the server each time.
# One KEY=value per line, values without quotes, comments on lines of their own.
# Use only letters, digits, - and _ in passwords and the invite code: no $, # or spaces.

# ---- Reaching the server (used by deploy.py on your computer) ----
# The site's address: the Elastic IP's four numbers joined with -, then .sslip.io; for the IP 13.250.1.2, write 13-250-1-2.sslip.io.
# If you get a domain of your own later, point it at this IP and put the domain here instead.
SITE_ADDRESS=
# The full path of the key file downloaded when creating the EC2 instance, for example C:\Users\<your user name>\.ssh\dss5105.pem
SSH_KEY=

# ---- OpenAI: a key just for the online site (give it a monthly limit in the OpenAI dashboard); the same model as on your computer ----
OPENAI_API_KEY=
OPENAI_MODEL=

# ---- The invite code needed to register: send it to the instructors and the group. A change takes effect after running deploy.py again; accounts already registered are not affected ----
REGISTRATION_CODE=

# ---- PostgreSQL on the server ----
# The database is created with these on the first deployment; don't change DB_USER or DB_PASSWORD after that (it could no longer connect).
# For the password, generate any string of letters and digits, at least 20 long; there is no need to remember it.
DB_NAME=dss5105_rental
DB_USER=dss5105
DB_PASSWORD=

# ---- OneMap: needed to work out commute times to places the user names (a gym, an office and so on); the same as in your own .env ----
ONEMAP_EMAIL=
ONEMAP_PASSWORD=
# The most route queries per minute sent to OneMap (240 by default).
# ONEMAP_CALLS_PER_MINUTE=240
